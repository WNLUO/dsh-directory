# 总控服务：在线地址驻内存，令牌保存在systemd管理的持久目录。
[Unit]
Description=DSH Directory (public relay control plane / address directory)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/opt/dsh-directory
StateDirectory=dsh-directory
StateDirectoryMode=0700
Environment=TOKEN_STORE_PATH=/var/lib/dsh-directory/tokens.jsonl
EnvironmentFile=/opt/dsh-directory/dsh-directory.env
ExecStart=/opt/dsh-directory/dsh-directory
Restart=always
RestartSec=2
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
